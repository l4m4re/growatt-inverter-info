{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l4m4re/growatt-inverter-info/schemas/reconciliation.json",
  "title": "Growatt declarative reconciliation decisions",
  "type": "object",
  "required": ["schema_version", "artifact", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact": {"const": "growatt_reconciliation_decisions"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision_record"}}
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["canonical_family", "namespace", "property"],
      "properties": {
        "canonical_family": {"type": "string", "minLength": 1},
        "namespace": {"enum": ["MODBUS", "GROWATT_FC0x20", "LOGICAL"]},
        "table": {"enum": ["holding", "input"]},
        "address": {"type": "integer", "minimum": 0, "maximum": 65535},
        "address_end": {"type": "integer", "minimum": 0, "maximum": 65535},
        "logical_object": {"type": "string", "minLength": 1},
        "property": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["family", "applicability"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "firmware": {"type": ["string", "null"]},
        "protocol_revision": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"]},
        "applicability": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["status", "value", "confidence"],
      "properties": {
        "status": {"enum": ["resolved", "provisionally_resolved", "unresolved", "not_applicable", "reserved", "scope_specific"]},
        "value": {},
        "confidence": {"enum": ["high", "medium", "low", "provisional", "unknown"]}
      },
      "additionalProperties": true
    },
    "rejection": {
      "type": "object",
      "required": ["claim_id", "disposition", "reason"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["rejected_for_scope", "rejected_as_artifact", "retained_as_conflict", "not_semantic_support"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision_record": {
      "type": "object",
      "required": ["decision_id", "target", "scope", "decision", "support", "conflicts", "rationale", "review"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "scope": {"$ref": "#/$defs/scope"},
        "decision": {"$ref": "#/$defs/decision"},
        "support": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/rejection"}},
        "rationale": {"type": "string", "minLength": 1},
        "review": {
          "type": "object",
          "required": ["status", "notes"],
          "properties": {"status": {"type": "string"}, "notes": {"type": "string"}, "reviewed_at": {"type": "string"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
