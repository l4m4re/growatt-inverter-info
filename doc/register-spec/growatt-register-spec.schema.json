{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growatt.example.com/schemas/growatt-register-spec-v1.json",
  "title": "Project-independent Growatt Register Specification v1",
  "type": "object",
  "required": ["specification", "evidence_vocabulary", "source_catalog", "families", "protocols", "registers", "logical_fields", "semantic_index", "native_read_evidence", "coverage"],
  "properties": {
    "specification": {"$ref": "#/$defs/specification"},
    "evidence_vocabulary": {"type": "object", "additionalProperties": {"type": "object", "required": ["description"], "properties": {"description": {"type": "string"}}, "additionalProperties": true}},
    "source_catalog": {"type": "object", "additionalProperties": {"type": "object"}},
    "families": {"type": "array", "items": {"$ref": "#/$defs/family"}},
    "protocols": {"type": "object", "additionalProperties": {"$ref": "#/$defs/protocol"}},
    "registers": {"type": "array", "items": {"$ref": "#/$defs/register"}},
    "logical_fields": {"type": "array", "items": {"$ref": "#/$defs/logical_field"}},
    "semantic_index": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "native_read_evidence": {"$ref": "#/$defs/native_evidence"},
    "derived_views": {"type": "object"},
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "specification": {
      "type": "object",
      "required": ["name", "version", "identity", "canonical_truth", "canonical_source_model", "artifact_role", "scope"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "identity": {"const": "family + table + address"},
        "canonical_truth": {"const": true},
        "canonical_source_model": {"type": "object", "required": ["kind", "maintained_in", "upstream_corpus", "migration_inputs", "status"], "properties": {"kind": {"const": "neutral_register_graph"}, "maintained_in": {"type": "string"}, "upstream_corpus": {"type": "string"}, "migration_inputs": {"type": "array", "items": {"type": "string"}}, "status": {"const": "bounded_migration"}}, "additionalProperties": false},
        "migration_input": {"type": "string"},
        "artifact_role": {"const": "canonical_machine_and_human_product"},
        "scope": {"type": "string"}
      },
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "required": ["id", "name", "slug", "protocol_group", "aliases", "models", "record_count", "live_hardware_observed"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "slug": {"type": "string"},
        "protocol_group": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}},
        "models": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"},
        "record_count": {"type": "integer", "minimum": 0}, "live_hardware_observed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "minimum_cmd_period_ms": {"type": ["integer", "null"]}, "recommended_cmd_period_ms": {"type": ["integer", "null"]},
        "maximum_read_words": {"type": ["integer", "null"]}, "maximum_write_words": {"type": ["integer", "null"]},
        "boundary_rules": {"type": "string"}, "native_read_blocks": {"type": "array", "items": {"type": "object"}}, "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "register": {
      "type": "object",
      "required": ["physical_id", "family", "table", "address", "length_words", "vendor", "normalized", "semantic_identity", "instance", "enums", "bitfields", "relationships", "resolution", "normalization", "evidence", "source_provenance", "write_policy", "native_read_blocks"],
      "properties": {
        "physical_id": {"type": "string"}, "family": {"type": "string"}, "family_name": {"type": "string"},
        "table": {"enum": ["holding", "input"]}, "address": {"type": "integer", "minimum": 0}, "length_words": {"type": "integer", "minimum": 1},
        "vendor": {"$ref": "#/$defs/vendor"}, "normalized": {"$ref": "#/$defs/normalized"},
        "semantic_identity": {"$ref": "#/$defs/semantic_identity"}, "instance": {"$ref": "#/$defs/instance"}, "component_of": {"type": "string"}, "component_role": {"type": "string"}, "logical_field_id": {"type": "string"},
        "enums": {"type": "array", "items": {"$ref": "#/$defs/enum"}},
        "bitfields": {"type": "array", "items": {"$ref": "#/$defs/bitfield"}},
        "packed_fields": {"type": ["array", "null"], "items": {"type": "object"}}, "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
        "resolution": {"$ref": "#/$defs/resolution"}, "normalization": {"$ref": "#/$defs/normalization"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "source_provenance": {"type": "array", "items": {"type": "string"}}, "source_aliases": {"type": "object"},
        "validation_evidence": {"type": "array", "items": {"type": "object"}}, "write_policy": {"enum": ["read_only", "never_test", "conditional", "reversible_candidate", "unknown_write_risk"]},
        "native_read_blocks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "vendor": {
      "type": "object",
      "required": ["variable_names", "description", "datatype_notation", "unit_notation", "access", "applicability"],
      "properties": {"variable_names": {"type": "array", "items": {"type": "string"}}, "description": {"type": ["string", "null"]}, "datatype_notation": {"type": ["string", "null"]}, "unit_notation": {"type": ["string", "null"]}, "access": {"type": "string"}, "applicability": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    },
    "normalized": {
      "type": "object",
      "required": ["name", "description", "raw_type", "signed", "divisor", "multiplier", "scale", "unit", "access"],
        "properties": {"name": {"type": ["string", "null"]}, "description": {"type": ["string", "null"]}, "raw_type": {"type": ["string", "null"]}, "signed": {"type": ["boolean", "null"]}, "signedness_status": {"type": "string"}, "signedness_note": {"type": "string"}, "divisor": {"type": ["number", "null"]}, "multiplier": {"type": ["number", "string", "null"]}, "scale": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]}, "access": {"type": "string"}},
      "additionalProperties": false
    },
    "semantic_identity": {
      "type": "object",
      "required": ["quantity", "canonical_name", "subsystem", "measurement_point", "instance_kind", "instance", "instance_status"],
      "properties": {"quantity": {"type": ["string", "null"]}, "canonical_name": {"type": ["string", "null"]}, "reconciliation_status": {"enum": ["reconciled", "syntactic_only", "unresolved"]}, "subsystem": {"type": "string"}, "measurement_point": {"type": "string"}, "instance_kind": {"type": ["string", "null"]}, "instance": {"type": ["integer", "null"]}, "instance_status": {"type": "string"}, "index_kind": {"type": ["string", "null"]}, "index": {"type": ["integer", "string", "null"]}, "structure_id": {"type": "string"}, "structure_note": {"type": "string"}, "relationship_role": {"type": "string"}},
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "required": ["instance_kind", "instance", "instance_status"],
      "properties": {"instance_kind": {"type": ["string", "null"]}, "instance": {"type": ["integer", "null"]}, "instance_status": {"type": "string"}, "index_kind": {"type": ["string", "null"]}, "index": {"type": ["integer", "string", "null"]}, "structure_id": {"type": "string"}, "structure_note": {"type": "string"}},
      "additionalProperties": false
    },
    "enum": {"type": "object", "required": ["value", "canonical_name", "vendor_label"], "properties": {"value": {"type": "integer"}, "canonical_name": {"type": "string"}, "vendor_label": {"type": "string"}, "ambiguous": {"type": "boolean"}}, "additionalProperties": false},
    "bitfield": {"type": "object", "required": ["bits", "name", "status", "provenance"], "properties": {"bits": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 15}}, "name": {"type": "string"}, "vendor_label": {"type": "string"}, "status": {"enum": ["structured", "partially_structured", "placeholder"]}, "description": {"type": "string"}, "provenance": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "relationship": {"type": "object", "required": ["type", "target"], "properties": {"type": {"enum": ["alternate", "legacy", "preferred", "supersedes", "superseded_by"]}, "target": {"type": "string"}}, "additionalProperties": false},
    "resolution": {"type": "object", "required": ["status", "confidence"], "properties": {"status": {"enum": ["resolved", "resolved_with_notes", "source_only", "unknown_reserved", "conflicted"]}, "confidence": {"type": ["string", "null"]}, "note": {"type": "string"}}, "additionalProperties": false},
    "normalization": {"type": "object", "required": ["status", "semantic_key_status", "semantic_reconciliation_status", "reason"], "properties": {"status": {"enum": ["assigned", "unresolved"]}, "semantic_key_status": {"enum": ["assigned", "unassigned"]}, "semantic_reconciliation_status": {"enum": ["reconciled", "syntactic_only", "unresolved"]}, "reason": {"type": ["string", "null"]}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["level", "sources"], "properties": {"level": {"enum": ["source_documented", "implementation_correlated", "read_observed", "value_plausible", "semantic_verified", "write_accepted", "write_reversible", "behavior_verified"]}, "sources": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "logical_field": {"type": "object", "required": ["id", "semantic_key", "canonical_name", "physical_registers", "encoding", "word_order", "word_order_status", "relationship_role", "relationships", "status"], "properties": {"id": {"type": "string"}, "semantic_key": {"type": ["string", "null"]}, "canonical_name": {"type": ["string", "null"]}, "canonical_description": {"type": ["string", "null"]}, "subsystem": {"type": "string"}, "measurement_point": {"type": "string"}, "instance": {"type": "object"}, "resolution": {"$ref": "#/$defs/resolution"}, "physical_registers": {"type": "array", "items": {"type": "object"}}, "encoding": {"type": ["string", "null"]}, "word_order": {"type": "string"}, "word_order_status": {"enum": ["source_explicit", "implementation_correlated", "inferred_with_notes", "unknown"]}, "divisor": {"type": ["number", "null"]}, "scale": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]}, "relationship_role": {"type": "string"}, "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}, "status": {"type": "string"}}, "additionalProperties": false},
    "native_evidence": {"type": "object", "required": ["source", "pages", "semantic_claim_policy"], "properties": {"source": {"type": "string"}, "capture": {"type": "object"}, "pages": {"type": "array", "items": {"type": "object"}}, "semantic_claim_policy": {"type": "string"}}, "additionalProperties": false},
    "coverage": {"type": "object", "required": ["physical_registers", "holding_registers", "input_registers", "meaningful_vendor_defined", "unknown_or_reserved", "semantic_concepts", "semantic_key_assigned_records", "semantic_reconciled_records", "semantic_unreconciled_records", "semantic_unresolved_records", "semantic_reconciled_percentage", "normalized_records", "normalized_percentage", "logical_multi_register_fields", "source_explicit_logical_fields", "implementation_correlated_logical_fields", "inferred_logical_fields", "unknown_word_order_logical_fields", "component_physical_registers", "component_as_alternate_errors_found", "component_as_alternate_relationships_removed", "indexed_structures", "enum_bearing_records", "bitfield_source_indicated_records", "bitfield_structured_records", "bitfield_partially_structured_records", "bitfield_placeholder_records", "defined_bit_or_range_count", "known_indexed_instances", "unknown_instance_structures", "read_only_records", "never_test_records", "conditional_records", "reversible_candidate_records", "unknown_write_risk_records"], "properties": {"physical_registers": {"type": "integer"}, "holding_registers": {"type": "integer"}, "input_registers": {"type": "integer"}, "meaningful_vendor_defined": {"type": "integer"}, "unknown_or_reserved": {"type": "integer"}, "semantic_concepts": {"type": "integer"}, "semantic_key_assigned_records": {"type": "integer"}, "semantic_reconciled_records": {"type": "integer"}, "semantic_unreconciled_records": {"type": "integer"}, "semantic_unresolved_records": {"type": "integer"}, "semantic_reconciled_percentage": {"type": "number"}, "normalized_records": {"type": "integer"}, "normalized_percentage": {"type": "number"}, "logical_multi_register_fields": {"type": "integer"}, "source_explicit_logical_fields": {"type": "integer"}, "implementation_correlated_logical_fields": {"type": "integer"}, "inferred_logical_fields": {"type": "integer"}, "unknown_word_order_logical_fields": {"type": "integer"}, "component_physical_registers": {"type": "integer"}, "component_as_alternate_errors_found": {"type": "integer"}, "component_as_alternate_relationships_removed": {"type": "integer"}, "indexed_structures": {"type": "integer"}, "enum_bearing_records": {"type": "integer"}, "bitfield_source_indicated_records": {"type": "integer"}, "bitfield_structured_records": {"type": "integer"}, "bitfield_partially_structured_records": {"type": "integer"}, "bitfield_placeholder_records": {"type": "integer"}, "defined_bit_or_range_count": {"type": "integer"}, "known_indexed_instances": {"type": "integer"}, "unknown_instance_structures": {"type": "integer"}, "read_only_records": {"type": "integer"}, "never_test_records": {"type": "integer"}, "conditional_records": {"type": "integer"}, "reversible_candidate_records": {"type": "integer"}, "unknown_write_risk_records": {"type": "integer"}}, "additionalProperties": true}
  }
}
