    "result": {
      "readback": "accepted for the two FC10 segments; unchanged H3082 FC06 was not required and its attempted write timed out; no retry was made",
      "mode_transition": "priority_raw 2 (Grid First) during the active slot and returned to 0 after the slot ended",
      "power_transition": "approximately 1.57 kW discharge while SOC was 53%; after reaching 52% discharge fell to approximately 0.12-0.13 kW",
      "load_context": "Peblar load was increased by the user to approximately 6 kW; observed inverter load was approximately 6.3-8.0 kW and power-to-grid remained 0 W, so this was battery-to-load behavior rather than grid export."
    }
