{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l4m4re/growatt-inverter-info/schemas/gii-pipeline-5b-claims.json",
  "title": "Growatt generic source claims",
  "type": "object",
  "required": ["schema_version", "artifact", "sources", "source_type_vocabulary", "claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact": {"const": "growatt_generic_source_claims"},
    "generated_by": {"type": "string"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "source_type_vocabulary": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "source_type", "artifact", "sha256"],
      "properties": {
        "source_id": {"type": "string"}, "source_type": {"type": "string"},
        "artifact": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "source_id", "source_type", "subject", "assertion", "provenance", "scope", "evidence"],
      "properties": {
        "claim_id": {"type": "string"}, "source_id": {"type": "string"}, "source_type": {"type": "string"},
        "subject": {"type": "object", "required": ["namespace", "family_scope"], "properties": {"namespace": {"type": "string"}, "family_scope": {"type": "array"}, "table": {"enum": ["input", "holding"]}, "address": {"type": "integer"}, "address_end": {"type": "integer"}}, "additionalProperties": true},
        "assertion": {"type": "object", "required": ["kind", "value"], "additionalProperties": true},
        "provenance": {"type": "object", "required": ["source_artifact"], "additionalProperties": true},
        "scope": {"type": "object", "required": ["family", "applicability"], "additionalProperties": true},
        "evidence": {"type": "object", "required": ["method", "confidence", "status", "grade"], "properties": {"grade": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}
      },
      "additionalProperties": false
    }
  }
}
